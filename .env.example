# Copy this file to .env and fill in real values. .env is gitignored (ARCHITECTURE.md §8).
ASSEMBLYAI_API_KEY=

# Required to try live capture (capture.html / run_interview.py) — defaults to false
# even locally, deliberately independent of ASSEMBLYAI_API_KEY (ADR-049). Restart
# uvicorn after changing it; --reload reloads code, not env vars.
VOICESTRESS_ENABLE_LIVE_CAPTURE=false

# Optional overrides — defaults match the verified endpoints in ARCHITECTURE.md §5
ASSEMBLYAI_VOICE_AGENT_WS_URL=wss://agents.assemblyai.com/v1/ws
ASSEMBLYAI_STREAMING_WS_URL=wss://streaming.assemblyai.com/v3/ws
ASSEMBLYAI_LLM_GATEWAY_URL=https://llm-gateway.assemblyai.com
